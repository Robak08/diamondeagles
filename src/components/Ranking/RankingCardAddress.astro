---
const { address } = Astro.props;

import { MapPin } from "@lucide/astro";

// https://maps.google.com/maps?q=Your+Address

const joinedAddress = address.trim().replaceAll(", ", ",").replaceAll(" ", "+");
---

<a
    class="item-address"
	href={"https://maps.google.com/maps?q=" + joinedAddress}
	target="_blank"
	rel="nofollower noreferrer noopener"
	><MapPin size="16" class="inline-block mr-1" />{address}</a
>

<style lang="postcss">
    @reference '@styles/app.css';
    a.item-address {
        @apply flex !items-start;
    }
</style>
