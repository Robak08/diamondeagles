---
import MapUsaSvg from "@components/MapUsaSvg.svelte";
---

<section id="about">
	<div class="map-bg">
		<MapUsaSvg />
	</div>
	<div class="grid gap-14 lg:grid-cols-4 xl:grid-cols-5">
		<div class="placeholder aspect-3/2">IMAGE PLACEHOLDER</div>
		<!-- <img
			src=""
			alt="placeholder"
			class="rounded-xl md:col-span-2 bg-muted/50"
		/> -->
		<div class="md:col-span-2 xl:col-span-3">
			<h1 class="mb-10">
				Recognizing
				<span class="bg-gradient-text"> Excellence</span>.
			</h1>
			<p>
				Diamond Eagles USA honors the top-performing businesses across the
				country—those who consistently deliver exceptional quality, drive
				growth, and lead with integrity. Each year, only a select few companies
				are chosen as regional leaders, earning the prestigious Eagle award for
				their standout achievements and commitment to excellence.
			</p>
			<p>
				Our mission is to help customers confidently choose the best local
				providers while empowering businesses to boost recognition, attract more
				customers, and strengthen their brand image. By joining the ranks of
				Diamond Eagles, companies gain a powerful edge — confirmation of their
				quality, increased market visibility, and a mark of trust that sets them
				apart from the competition.
			</p>

			<!-- Clients choice
			The ranking is based on customer reviews posted on the most popular review platforms, enhanced by our proprietary algorithm that evaluates additional key factors.		 -->
			<div class="mt-6 grid grid-cols-2 gap-6 text-center">
				<div class="about-stat">
					<span class="about-stat-number">2025</span>
					<span class="about-stat-text">Launched</span>
				</div>
				<div class="about-stat">
					<span class="about-stat-number">50 states</span>
					<span class="about-stat-text"> Served across USA </span>
				</div>
			</div>
		</div>
	</div>
</section>

<style lang="postcss">
    @reference '@styles/app.css';
	#about {
		@apply relative z-0 scroll-mt-20;
		.map-bg {
			@apply w-full h-full mx-auto;
			@apply absolute inset-auto;
			@apply flex justify-center items-center -z-1;
		}
		.about-stat {
			@apply flex flex-col items-center justify-center gap-2 rounded-xl border bg-background;
			@apply p-4 pb-2 md:px-6 md:pt-6 md:pb-3 select-none;
			.about-stat-number {
				@apply text-2xl md:text-4xl;
			}
			.about-stat-text {
				@apply text-sm text-muted-foreground md:text-lg;
			}
		}
	}
</style>
