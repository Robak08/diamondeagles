---
import { Picture } from "astro:assets";
import benefitsImg from "@/assets/de_benefits_main.jpg";
---

<script>
	import { animate, stagger, inView } from "motion";

	inView(
		".benefits-grid",
		(element) => {
			// const animation = animate(
			// 	element,
			// 	{ opacity: [0, 1] },
			// 	{ ease: [0.39, 0.24, 0.3, 1], duration: 1 }
			// );
			const mainImage = animate(
				".center-img",
				{ opacity: [0, 1] },
				{ ease: [0.39, 0.24, 0.3, 1], duration: 1.5 }
			);

			const benefits = element.querySelectorAll(".benefit");
			if (benefits.length > 0) {
				animate(
					benefits,
					{ opacity: [0, 1] },
					{ delay: stagger(0.25, { startDelay: 0.35 }) }
				);
			}
			const arrows = element.querySelectorAll(".arrow");
			if (arrows.length > 0) {
				animate(
					arrows,
					{ opacity: [0, 0.6] },
					{ delay: stagger(0.15, { startDelay: 0.25 }) }
				);
			}
			// return () => {
			// 	mainImage.stop();
			// };
		},
		{ amount: 0.35 }
	);
</script>

