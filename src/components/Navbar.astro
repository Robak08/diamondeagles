---
import Logo from "./Logo.svelte";
import { MenuBar } from "@components/MenuBar.tsx";
import { MobileMenu } from "@components/MobileMenu.tsx";
// import MobileNav from "@components/MobileNav.astro";
import { ThemeToggle } from "@components/ThemeToggle.tsx";
import FacebookButton from "@components/Socials/FacebookButton.astro";
import InstagramButton from "@components/Socials/InstagramButton.astro";
// @ts-ignore
const currentPath = Astro.url.pathname;
import { navLinks, footerLinks } from "@lib/links";

let mobileLinks = navLinks.filter((link) => link.href !== "/industries");
mobileLinks = [...mobileLinks, ...footerLinks];
// const industriesLinks = links.filter(link=>link.href === '/industries');
---

<script>
	// @ts-ignore
	const navElClassList = document.getElementById("nav").classList;

	window.onscroll = (e) => {
		// console.log();
		// @ts-ignore
		if (e.target.documentElement.scrollTop > 40) {
			if (!navElClassList.contains("scrolled")) navElClassList.add("scrolled");
		} else {
			if (navElClassList.contains("scrolled"))
				navElClassList.remove("scrolled");
		}
	};
</script>

<div id="nav" class="navbar">
	<div class="flex-1">
		<Logo header />
	</div>
	<div class="menu-horizontal">
		<!-- 768px+ -->
		<MenuBar client:media="(min-width: 48rem)" links={navLinks} {currentPath} />
		<InstagramButton />
		<FacebookButton />
		<ThemeToggle client:media="(min-width: 48rem)" />
	</div>
	<div class="menu-mobile">
		<!-- 768px- -->
		<InstagramButton />
		<FacebookButton />
		<MobileMenu
			client:media="(max-width: 48rem)"
			links={mobileLinks}
			{currentPath}
		/>
	</div>
</div>

<style lang="postcss">
	@reference '@styles/app.css';
	.navbar {
		@apply z-10 sticky isolate top-0;
		/* @apply shadow-sm rounded-lg m-4; */
		@apply flex flex-row items-center p-2 md:px-4;
		/* @apply dark:bg-zinc-900/80 bg-white/60 backdrop-blur-xs; */
		@apply bg-transparent transition-colors;
		&.scrolled {
			@apply dark:bg-zinc-900/90 bg-white/90 backdrop-blur-xs;
		}
	}
	.menu-horizontal {
		@apply hidden md:flex flex-none flex-row items-center gap-2 z-3;
		> li {
			@apply mx-1;
		}
	}
	.menu-mobile {
		@apply flex md:hidden;
	}
</style>
